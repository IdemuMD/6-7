<%- include("../partials/header", { title }) %>

<section class="page-heading">
  <div>
    <h2>Min side</h2>
    <p>Dine registrerte kjæledyr og valgt veterinær.</p>
  </div>
  <a class="button" href="/min-side/eier/kjaeledyr/ny">Legg til kjæledyr</a>
</section>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<table>
  <thead>
    <tr>
      <th>Navn</th>
      <th>Art</th>
      <th>Rase</th>
      <th>Alder</th>
      <th>Veterinær</th>
      <th>Telefon</th>
    </tr>
  </thead>
  <tbody>
    <% if (pets.length === 0) { %>
      <tr>
        <td colspan="6" class="empty">Du har ingen kjæledyr registrert ennå.</td>
      </tr>
    <% } %>

    <% pets.forEach((pet) => { %>
      <tr>
        <td><%= pet.navn %></td>
        <td><%= pet.art %></td>
        <td><%= pet.rase %></td>
        <td><%= pet.alder %></td>
        <td><%= pet.veterinaerId ? pet.veterinaerId.navn : "Mangler veterinær" %></td>
        <td><%= pet.veterinaerId ? pet.veterinaerId.telefon : "-" %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include("../partials/footer") %>
