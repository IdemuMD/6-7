<%- include("../partials/header", { title }) %>

<section class="page-heading">
  <div>
    <h2>Owners</h2>
    <p>Registered owners and contact information.</p>
  </div>
  <a class="button" href="/auth/register?role=owner">Ny eierkonto</a>
</section>

<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Phone</th>
      <th>Address</th>
      <th class="actions">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (owners.length === 0) { %>
      <tr>
        <td colspan="4" class="empty">No owners have been registered yet.</td>
      </tr>
    <% } %>

    <% owners.forEach((owner) => { %>
      <tr>
        <td><%= owner.navn %></td>
        <td><%= owner.telefon %></td>
        <td><%= owner.adresse %></td>
        <td class="actions">
          <a class="small-button" href="/owners/<%= owner._id %>/edit">Edit</a>
          <% if (typeof currentUser !== "undefined" && currentUser && currentUser.role === "veterinarian") { %>
            <form action="/owners/<%= owner._id %>/delete" method="POST">
              <button class="danger-button" type="submit">Delete</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include("../partials/footer") %>
