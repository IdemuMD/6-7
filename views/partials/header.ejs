<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | 6-7 Pets</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="site-header">
    <div>
      <h1>6-7 Pets</h1>
      <p>Pets, owners and veterinarians</p>
    </div>
    <nav aria-label="Main navigation">
      <a href="/pets">Pets</a>
      <a href="/owners">Owners</a>
      <a href="/veterinarians">Veterinarians</a>
      <% if (typeof currentUser !== "undefined" && currentUser) { %>
        <% if (currentUser.role === "owner") { %>
          <a href="/min-side/eier">Min side</a>
        <% } else { %>
          <a href="/min-side/veterinaer">Min side</a>
        <% } %>
        <form class="nav-form" action="/auth/logout" method="POST">
          <button class="nav-button" type="submit">Logg ut</button>
        </form>
      <% } else { %>
        <a href="/auth/login">Logg inn</a>
        <a href="/auth/register">Ny bruker</a>
      <% } %>
    </nav>
  </header>

  <main class="container">
